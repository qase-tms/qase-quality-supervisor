{
  "description": "Block Qase MCP tool calls that could delete data: any *delete* call, and any qase_api call whose method is DELETE, on a server the user named qase or on the plugin's own (mcp__plugin_quality-supervisor_qase__*). Fail-closed: an internal error blocks the call.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(qase|plugin_quality-supervisor_qase)__.*delete.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/deny-destructive.sh\""
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/hooks/deny-destructive.ps1"
            ],
            "shell": "powershell"
          }
        ]
      },
      {
        "matcher": "mcp__(qase|plugin_quality-supervisor_qase)__qase_api",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/deny-destructive-api.sh\""
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/hooks/deny-destructive-api.ps1"
            ],
            "shell": "powershell"
          }
        ]
      }
    ]
  }
}
