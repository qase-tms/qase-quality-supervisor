{
  "description": "Block Qase MCP tool calls that could delete data: any mcp__qase__*delete* call, and any mcp__qase__qase_api call whose method is DELETE. Fail-closed: an internal error blocks the call.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__qase__.*delete.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/deny-destructive.sh\""
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/hooks/deny-destructive.ps1"
            ],
            "shell": "powershell"
          }
        ]
      },
      {
        "matcher": "mcp__qase__qase_api",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/deny-destructive-api.sh\""
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/hooks/deny-destructive-api.ps1"
            ],
            "shell": "powershell"
          }
        ]
      }
    ]
  }
}
